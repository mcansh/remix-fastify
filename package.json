{
  "name": "react-router-fastify-workspace",
  "private": true,
  "license": "MIT",
  "repository": "mcansh/remix-fastify",
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive --filter './packages/*' run build",
    "clean": "git clean -fdX",
    "example:build": "pnpm --dir examples/basic run build",
    "example:dev": "pnpm --dir examples/basic run dev",
    "example:start": "pnpm --dir examples/basic run start",
    "example:typecheck": "pnpm --dir examples/basic run typecheck",
    "test": "pnpm --filter @mcansh/react-router-fastify run test",
    "typecheck": "pnpm --recursive --filter './packages/*' run typecheck",
    "validate": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run example:typecheck && pnpm run example:build",
    "changeset": "changeset",
    "changeset:version": "changeset version && node ./scripts/remove-prerelease-changelogs.ts && node ./scripts/post-changeset.ts",
    "changeset:release": "pnpm run build && pnpm publish -r",
    "format": "oxfmt",
    "lint": "oxlint"
  },
  "dependencies": {
    "@changesets/cli": "^3.0.3",
    "@manypkg/get-packages": "^3.1.0",
    "@npmcli/package-json": "^8.0.0",
    "@oxlint/plugins": "^1.87.0",
    "@types/node": "^26.6.4",
    "@types/npmcli__package-json": "^4.0.4",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "pkg-pr-new": "^0.0.91",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.28.5+sha512.484563d30b4c2ad27cb48aa94ff2b302dbcebc8ff6bf28816c2589886e146ce7f76f354f3bc1a438e6f5e9768c302aa0a6f7add8232903cd4cf81426cbc14d9e"
}
