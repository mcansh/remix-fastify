{
  "name": "react-router-fastify-workspace",
  "private": true,
  "license": "MIT",
  "repository": "mcansh/remix-fastify",
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive --filter './packages/*' --filter './examples/*' run build",
    "build:packages": "pnpm --recursive --filter './packages/*' run build",
    "clean": "git clean -fdX",
    "example:build": "pnpm --dir examples/basic run build",
    "example:dev": "pnpm --dir examples/basic run dev",
    "example:start": "pnpm --dir examples/basic run start",
    "example:typecheck": "pnpm --dir examples/basic run typecheck",
    "test": "node --test scripts/publish.test.ts && pnpm --filter @mcansh/react-router-fastify run test",
    "typecheck": "pnpm --recursive --filter './packages/*' run typecheck",
    "validate": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run example:typecheck",
    "changeset": "changeset",
    "changeset:version": "changeset version && node ./scripts/remove-prerelease-changelogs.ts && node ./scripts/post-changeset.ts",
    "changeset:release": "pnpm run build:packages && changeset publish",
    "format": "oxfmt",
    "lint": "oxlint --fix"
  },
  "dependencies": {
    "@changesets/cli": "^3.0.3",
    "@manypkg/get-packages": "^3.1.0",
    "@npmcli/package-json": "^8.0.0",
    "@oxlint/plugins": "^1.93.0",
    "@types/node": "^26.6.6",
    "@types/npmcli__package-json": "^4.0.4",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "pkg-pr-new": "^0.0.93",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "railway": "^3.16.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.18.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
